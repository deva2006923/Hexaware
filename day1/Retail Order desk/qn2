#CODE

import csv

with open("orders.csv", "r") as file:
    orders = list(csv.DictReader(file))


# Bubble Sort
def bubble(data):
    arr = data.copy()
    n = len(arr)

    for i in range(n - 1):
        for j in range(n - i - 1):
            if int(arr[j]["amount"]) < int(arr[j + 1]["amount"]):
                arr[j], arr[j + 1] = arr[j + 1], arr[j]

    return arr


# Merge Sort
def merge(arr):
    if len(arr) <= 1:
        return arr
    mid = len(arr) // 2
    left = merge(arr[:mid])
    right = merge(arr[mid:])
    result = []
    i = 0
    j = 0
    while i < len(left) and j < len(right):
        if int(left[i]["amount"]) >= int(right[j]["amount"]):
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1

    result.extend(left[i:])
    result.extend(right[j:])
    return result



bubble_result = bubble(orders)
merge_result = merge(orders)
print([int(order["amount"]) for order in merge_result])
builtin_result = sorted(
    orders,
    key=lambda order: int(order["amount"]),
    reverse=True
)
print([int(order["amount"]) for order in builtin_result])
